<?xml version="1.0"?>
<robot name="simple_4dof_revolute_arm">
  <link name="base_link"><inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial></link>
  <link name="link1"><inertial><origin xyz="0.05 0 0" rpy="0 0 0"/><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial></link>
  <link name="link2"><inertial><origin xyz="0.05 0 0" rpy="0 0 0"/><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial></link>
  <link name="link3"><inertial><origin xyz="0.05 0 0" rpy="0 0 0"/><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial></link>
  <link name="tool0"><inertial><origin xyz="0.02 0 0" rpy="0 0 0"/><mass value="0.001"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial></link>
  <joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.5" upper="1.5" effort="8.0" velocity="2.0"/></joint>
  <joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0.1 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.4" upper="1.4" effort="7.0" velocity="2.5"/></joint>
  <joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/><origin xyz="0.1 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.2" upper="1.2" effort="6.0" velocity="2.0"/></joint>
  <joint name="joint4" type="revolute"><parent link="link3"/><child link="tool0"/><origin xyz="0.1 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-1.0" upper="1.0" effort="5.0" velocity="1.5"/></joint>
</robot>
