<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>serial_arm_ros2_control</name>
    <version>0.1.0</version>
    <description>Generic ros2_control hardware interface and launch layer for SerialArm.</description>
    <maintainer email="kaerei86@gmail.com">kaede-rei</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>serial_arm_core</depend>
    <depend>serial_arm_robot_profiles</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>hardware_interface</depend>
    <depend>controller_manager</depend>
    <depend>controller_manager_msgs</depend>
    <depend>pluginlib</depend>
    <depend>realtime_tools</depend>
    <depend>joint_state_broadcaster</depend>
    <depend>joint_trajectory_controller</depend>
    <depend>xacro</depend>
    <depend>robot_state_publisher</depend>
    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>joint_state_publisher_gui</exec_depend>
    <exec_depend>rviz2</exec_depend>
    <test_depend>ament_cmake_pytest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
